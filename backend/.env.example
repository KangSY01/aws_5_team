# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# 실행: uv run --env-file .env <명령>

# 개발 모드 스위치 (1=켜짐, 0=꺼짐)
USE_MOCK=1
FAKE_LLM=1
# 설정하면 현재 시각 대신 이 값을 쓴다 (예: 2026-11-21T10:00:00+09:00)
DEMO_NOW=
# 데모 장면 1 일정 캐시 (true 면 대본 일본어 문장에만 대본 일정을 돌려준다). 기본 false
DEMO_CACHE_ENABLED=false

# Bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
AWS_REGION=ap-northeast-2
# 선택
BEDROCK_EMBED_MODEL_ID=

# 공공데이터포털 서비스 키 (USE_MOCK=0일 때 DECODING 필수)
# requests가 URL 인코딩을 하므로 Decoding 키를 쓴다.
DATA_GO_KR_KEY_DECODING=
# 선택
DATA_GO_KR_KEY_ENCODING=

# DynamoDB 단일 테이블 이름 (DynamoDB 저장소일 때 필수)
DYNAMODB_TABLE=
# 사진 업로드 S3 버킷 이름 (USE_MOCK=0 에서 사진 인식에 필요). busan-guide-base 의 UploadsBucketName 출력값
UPLOADS_BUCKET=
# 저장소 종류: memory | dynamodb | 비우면 USE_MOCK 을 따른다 (1=memory, 0=dynamodb). AWS 배포는 dynamodb 로 고정
STORAGE_BACKEND=
# 선택 항목
KMA_API_KEY=
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=

# Weather cache DynamoDB table (blank = busan-guide-cache)
CACHE_TABLE=
