# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# 실행: uv run --env-file .env <명령>

# 개발 모드 스위치 (1=켜짐, 0=꺼짐)
USE_MOCK=1
FAKE_LLM=1
# 설정하면 현재 시각 대신 이 값을 쓴다 (예: 2026-11-21T10:00:00+09:00)
DEMO_NOW=

# Bedrock
MODEL_ID=global.anthropic.claude-haiku-5-5
BEDROCK_REGION=ap-northeast-2

# 공공데이터포털 서비스 키 (USE_MOCK=0일 때 필수)
DATA_GO_KR_KEY=
