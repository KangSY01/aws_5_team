# 복사해서 .env 로 저장한 뒤 값을 채운다. .env 는 커밋하지 않는다.
# 실행: uv run --env-file .env <명령>

# 개발 모드 스위치 (1=켜짐, 0=꺼짐)
USE_MOCK=1
FAKE_LLM=1
# 설정하면 현재 시각 대신 이 값을 쓴다 (예: 2026-11-21T10:00:00+09:00)
DEMO_NOW=

# Bedrock
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5
AWS_REGION=ap-northeast-2
# 선택
BEDROCK_EMBED_MODEL_ID=

# 공공데이터포털 서비스 키 (USE_MOCK=0일 때 DECODING 필수)
# requests가 URL 인코딩을 하므로 Decoding 키를 쓴다.
DATA_GO_KR_KEY_DECODING=
# 선택
DATA_GO_KR_KEY_ENCODING=

# 선택 항목
KMA_API_KEY=
KAKAO_JS_KEY=
KAKAO_REST_API_KEY=
